{
  "name": "irminsul-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "prisma:generate": "node scripts/run-prisma.js generate",
    "prisma:migrate:deploy": "node scripts/run-prisma.js migrate deploy",
    "prisma:migrate:dev": "node scripts/run-prisma.js migrate dev",
    "prisma:push": "node scripts/run-prisma.js db push",
    "prisma:validate": "node scripts/run-prisma.js validate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@prisma/client": "^5.0.0",
    "fast-safe-stringify": "^2.1.1",
    "genshin-db": "^5.2.13",
    "next": "14.2.35",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "prisma": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
